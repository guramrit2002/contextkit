# ============================================================================
# contextkit Environment Configuration
# ============================================================================
# Copy this file to .env and update with your local values
# DO NOT commit .env to git - it contains sensitive information
# ============================================================================

# ============================================================================
# CORE SETTINGS
# ============================================================================

# Default user ID for single-user mode (Step 1)
# In Step 2+, this will be set per authenticated user
DEFAULT_USER_ID=default_user

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Required. contextkit runs only against the deployed Postgres database (ADR 029): core and
# Django share this one database, and both refuse to start without it.
# Use the Supabase *session-mode pooler* URL (port 5432, not the 6543 transaction pooler, and
# not the IPv6-only direct connection), with sslmode=require. No brackets around the
# password, and URL-encode special characters in it (e.g. @ -> %40, # -> %23).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# The test suites never use DATABASE_URL: they set CONTEXTKIT_ALLOW_SQLITE=true themselves and
# run on throwaway SQLite files. Never set it on a server.

# Hosted mode (set on the hosted server only, e.g. Render; ADR 027). When true: an API key is always
# required (regardless of REQUIRE_AUTH), and the server never uses its own git remote or
# working directory as a project.
# CONTEXTKIT_HOSTED=true

# ============================================================================
# DJANGO SETTINGS (for Step 2+ backend)
# ============================================================================

# Security key (generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())')
# Wrap it in single quotes: generated keys can contain '$', which Docker Compose would
# otherwise treat as a variable and silently strip.
DJANGO_SECRET_KEY='your-secret-key-here-change-in-production'

# Debug mode (must be False in production)
DJANGO_DEBUG=True

# Allowed hosts (comma-separated for multiple hosts)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Behind a reverse proxy that terminates HTTPS (set by the deployment):
# origins allowed to submit forms such as the admin login, and whether to trust the
# proxy's X-Forwarded-Proto header. Only enable DJANGO_BEHIND_PROXY behind a proxy.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
# DJANGO_BEHIND_PROXY=true

# User API (ADR 028): websites allowed to call /api/v1/ from the browser, and the login
# throttle (per client IP).
# DJANGO_CORS_ALLOWED_ORIGINS=https://contextkit.example.com,http://localhost:5173
# DJANGO_AUTH_THROTTLE_RATE=10/min

# GitHub sign-in for the website (a GitHub OAuth App; callback URL = the website's URL).
# The secret stays on the server. GITHUB_ALLOWED_LOGINS optionally limits who can sign in
# (comma-separated GitHub usernames; empty means anyone with a GitHub account).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_ALLOWED_LOGINS=

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Reject tool calls that carry no API key (set True when hosted).
# When False, calls without a key run as local single-user mode; a key that is
# provided is still verified.
REQUIRE_AUTH=False

# ============================================================================
# OPTIONAL: EXTERNAL SERVICES (Step 2+)
# ============================================================================

# AWS Configuration (if using AWS for storage)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=contextkit-storage

# Google Cloud Configuration (if using GCP for storage)
# GCP_PROJECT_ID=your-project-id
# GCP_CREDENTIALS_FILE=/path/to/credentials.json

# ============================================================================
# OPTIONAL: MONITORING & OBSERVABILITY
# ============================================================================

# Sentry (error tracking)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id

# OpenTelemetry (distributed tracing)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=contextkit

# ============================================================================
# OPTIONAL: INTEGRATION SETTINGS
# ============================================================================

# Claude Code MCP Integration
# CLAUDE_CODE_MCP_ENABLED=True

# Codex Integration
# CODEX_MCP_ENABLED=True

# Cursor Integration
# CURSOR_MCP_ENABLED=True
