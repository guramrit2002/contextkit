# Both values are public. Without either one, the "Get key" button is hidden and the site stays
# fully static.

# Base URL of the contextkit Django backend that serves /api/v1/ (no trailing slash).
# The backend must list this site's origin in DJANGO_CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=https://<stable backend domain>

# Client ID of the GitHub OAuth app. Its callback URL must be this site's origin plus "/",
# e.g. https://contextkit.example.com/ (http://localhost:5180/ for local testing).
VITE_GITHUB_CLIENT_ID=<GitHub OAuth app client id>
